[gd_scene format=3]

[ext_resource type="Script" path="res://Scenes/UI/BattleMenu/income_row.gd" id="1_income_row"]
[ext_resource type="Script" path="res://Scripts/UI/icon_value.gd" id="2_icon_value"]
[ext_resource type="Texture2D" path="res://Assets/Art/Icons/gold.png" id="3_gold"]
[ext_resource type="Texture2D" path="res://Assets/Art/Icons/cooldown.png" id="4_cooldown"]
[ext_resource type="Texture2D" path="res://Assets/Art/UI/bar_gold.png" id="20_bar_gold"]

[sub_resource type="StyleBoxTexture" id="cycle_fill"]
texture = ExtResource("20_bar_gold")
texture_margin_left = 6.0
texture_margin_top = 6.0
texture_margin_right = 6.0
texture_margin_bottom = 6.0

[node name="IncomeRow" type="PanelContainer"]
theme_type_variation = &"CardPanel"
script = ExtResource("1_income_row")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Icon" type="ColorRect" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(88, 88)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
color = Color(0.17, 0.15, 0.17, 1)

[node name="IconArt" type="TextureRect" parent="Row/Icon"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 4.0
offset_right = -8.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="InitialLabel" type="Label" parent="Row/Icon"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"HeaderLabel"
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.6)
theme_override_constants/outline_size = 8
text = "L"
horizontal_alignment = 1
vertical_alignment = 1

[node name="LevelBadge" type="Label" parent="Row/Icon"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -30.0
grow_horizontal = 2
grow_vertical = 0
theme_type_variation = &"SmallLabel"
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.85)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 22
horizontal_alignment = 1

[node name="Info" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 4

[node name="TitleLabel" type="Label" parent="Row/Info"]
unique_name_in_owner = true
layout_mode = 2
text = "Source"
text_overrun_behavior = 3

[node name="DetailRow" type="HBoxContainer" parent="Row/Info"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 16

[node name="PayoutValue" type="HBoxContainer" parent="Row/Info/DetailRow"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("2_icon_value")
icon = ExtResource("3_gold")
icon_size = 28.0
label_variation = &"SmallLabel"
font_size = 24

[node name="CycleValue" type="HBoxContainer" parent="Row/Info/DetailRow"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("2_icon_value")
icon = ExtResource("4_cooldown")
icon_size = 28.0
label_variation = &"SmallLabel"
font_size = 24

[node name="GainLabel" type="Label" parent="Row/Info/DetailRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallLabel"
theme_override_colors/font_color = Color(0.55, 0.85, 0.55, 1)
theme_override_font_sizes/font_size = 22

[node name="CycleBar" type="ProgressBar" parent="Row/Info"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
mouse_filter = 2
theme_override_styles/fill = SubResource("cycle_fill")
max_value = 1.0
step = 0.0
show_percentage = false

[node name="CycleLabel" type="Label" parent="Row/Info/CycleBar"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"SmallLabel"
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.7)
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 18
text = "3.0s"
horizontal_alignment = 1
vertical_alignment = 1

[node name="LevelUpButton" type="Button" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(210, 96)
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"SuccessButton"
theme_override_constants/icon_max_width = 30
theme_override_font_sizes/font_size = 26
text = "Lv up"
icon = ExtResource("3_gold")

[connection signal="pressed" from="Row/LevelUpButton" to="." method="_on_level_up_button_pressed"]
