[node name="BattleMenu" type="PanelContainer"]
theme_type_variation = &"DockBottomPanel"
script = ExtResource("1_battle_menu")

[node name="SafeArea" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
script = ExtResource("safe_area_script")
base_margin = 0
apply_top = false
apply_bottom = true

[node name="Content" type="VBoxContainer" parent="SafeArea"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Toolbar" type="HBoxContainer" parent="SafeArea/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="PageTitle" type="Label" parent="SafeArea/Content/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Heroes"

[node name="BuyAmountButton" type="Button" parent="SafeArea/Content/Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 64)
layout_mode = 2
theme_type_variation = &"SecondaryButton"
theme_override_font_sizes/font_size = 26
text = "x1"

[node name="HeroesPage" type="ScrollContainer" parent="SafeArea/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

