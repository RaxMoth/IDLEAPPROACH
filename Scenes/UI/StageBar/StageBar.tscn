icon = ExtResource("5_income")
icon_size = 28.0
label_variation = &"SmallLabel"

[node name="DpsValue" type="HBoxContainer" parent="SafeArea/Content/TopRow/GoldInfo/StatsRow"]
unique_name_in_owner = true
layout_mode = 2
